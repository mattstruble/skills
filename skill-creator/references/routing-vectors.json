{
  "frontmatter": [
    {
      "text": "---\nname: \"foo\"\nsummary: 'bar baz'\ntype: process\n---\n# Body",
      "expect": {
        "name": "foo",
        "summary": "bar baz",
        "type": "process"
      }
    },
    {
      "text": "---\nname: x\ndescription: >-\n  Use when writing\n  things well.\n---\n",
      "expect": {
        "name": "x",
        "description": "Use when writing things well."
      }
    },
    {
      "text": "---\nname: x\ndescription: |-\n  line one\n  line two\n---\n",
      "expect": {
        "description": "line one\nline two"
      }
    },
    {
      "text": "---\nname: x\ndescription: \"say \\\"hi\\\"\"\n---\n",
      "expect": {
        "description": "say \"hi\""
      }
    },
    {
      "text": "---\nname: x\nmetadata:\n  route-prompt: \"write*test git-push\"\n  route-paths: '**/*.nix **/Chart.yaml'\n  route-commands: pytest uv-run-pytest\n---\n",
      "expect": {
        "metadata": {
          "route-prompt": "write*test git-push",
          "route-paths": "**/*.nix **/Chart.yaml",
          "route-commands": "pytest uv-run-pytest"
        }
      }
    },
    {
      "text": "---\nname: x\ndisable-model-invocation: true\n---\n",
      "expect": {
        "disable-model-invocation": true
      }
    },
    {
      "text": "---\nname: x\ndisable-model-invocation: false\n---\n",
      "expect": {
        "disable-model-invocation": false
      }
    },
    {
      "text": "---\nname: x\nmetadata:\n  route-prompt: [a, b]\n---\n",
      "expect": {
        "errors": [
          "metadata.route-prompt: value must be a string"
        ]
      }
    },
    {
      "text": "---\nname: x\nmetadata:\n  route-prompt:\n    - a\n    - b\n---\n",
      "expect": {
        "errors": [
          "metadata.route-prompt: value must be a string",
          "metadata: unsupported nested value: '- a'",
          "metadata: unsupported nested value: '- b'"
        ]
      }
    },
    {
      "text": "# Just a heading\n\nNo frontmatter.",
      "expect": {}
    }
  ],
  "keywords": [
